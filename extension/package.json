{
  "name": "hovertv-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/background.ts src/content.ts src/popup.ts --bundle --outdir=dist --target=chrome100 --sourcemap",
    "build:prod": "esbuild src/background.ts src/content.ts src/popup.ts --bundle --outdir=dist --target=chrome100 --minify",
    "test": "tsx --test src/**/*.test.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3"
  }
}
